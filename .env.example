# Test PBX settings, read by compose.yml and the entrypoint.
# make init creates .env from this file, with random passwords.

# Address the phones reach the PBX at, and the interface ports are published
# on: 127.0.0.1 for phones on the host, the host LAN address and 0.0.0.0 to
# reach it from the LAN (make host_ip).
PBX_EXTERNAL_IP=127.0.0.1
PBX_BIND=127.0.0.1
# Captures UI, http://127.0.0.1:8080. The captures hold the calls audio and
# the SIP authentication exchanges: keep it on 127.0.0.1.
CAPTURE_BIND=127.0.0.1
# New capture file every CAPTURE_ROTATE seconds, CAPTURE_KEEP files kept
CAPTURE_ROTATE=900
CAPTURE_KEEP=48

SIP_PASSWORD_100=
SIP_PASSWORD_101=
SIP_PASSWORD_102=

# Extension ringing for inbound trunk calls
INBOUND_EXTEN=100
# Pre-answer music to inbound trunk callers, 183 Session Progress, yes or no
PBX_PREANSWER=no

# SIP trunk, leave TRUNK_HOST empty to disable it.
# TRUNK_HOST: SIP domain of the line. TRUNK_USER: line number alone, without
# @domain. TRUNK_PROXY: provider SBC, when it is not TRUNK_HOST.
TRUNK_HOST=
TRUNK_USER=
TRUNK_PASSWORD=
TRUNK_PROXY=
